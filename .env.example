# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# On Vercel: Set this in Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# OPTIONAL: Persistent Cloud State Storage for Vercel Serverless
# ------------------------------------------------------------------------------
# If deploying to Vercel and you want state to sync across devices/browsers:
# Option A - Vercel KV (automatically set by Vercel when you add KV Storage):
# KV_REST_API_URL="https://..."
# KV_REST_API_TOKEN="..."
#
# Option B - Upstash Redis (free tier available at console.upstash.com):
# UPSTASH_REDIS_REST_URL="https://..."
# UPSTASH_REDIS_REST_TOKEN="..."
#
# Note: If neither is configured on Vercel, the app automatically falls back to
# client-side localStorage sync so user transactions and budgets are never lost.
